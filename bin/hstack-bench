#!/usr/bin/env python3
"""Repeat a command and report the wall-clock spread.

One sample is not a result. A non-zero exit means the number is not a result.
This file does not compare against a baseline and does not tune anything.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import time


def main() -> int:
    parser = argparse.ArgumentParser(prog="hstack-bench")
    parser.add_argument("--repeat", type=int, default=3)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = list(args.command)
    if command and command[0] == "--":
        command = command[1:]
    if args.repeat < 3:
        print("hstack-bench: need at least 3 repeats", file=sys.stderr)
        return 2
    if not command:
        print("hstack-bench: missing command", file=sys.stderr)
        return 2
    shown = " ".join(command)
    if args.dry_run:
        print(f"hstack-bench: would run {args.repeat} times: {shown}")
        return 0
    elapsed: list[float] = []
    codes: list[int] = []
    for _ in range(args.repeat):
        started = time.perf_counter()
        completed = subprocess.run(command)
        elapsed.append(time.perf_counter() - started)
        codes.append(completed.returncode)
    ordered = sorted(elapsed)
    median = ordered[len(ordered) // 2]
    print(f"command {shown}")
    print(f"repeats {args.repeat}")
    print(f"min_s {ordered[0]:.4f}")
    print(f"median_s {median:.4f}")
    print(f"max_s {ordered[-1]:.4f}")
    print("exits " + " ".join(str(code) for code in codes))
    if any(code != 0 for code in codes):
        print("not_a_result nonzero_exit")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
