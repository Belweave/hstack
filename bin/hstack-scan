#!/usr/bin/env python3
"""Run secret and dependency scanners that are already installed.

gitleaks is MIT. osv-scanner is Apache-2.0. If neither is on PATH, this
script says so and exits 0. It does not download them.
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys


def main() -> int:
    parser = argparse.ArgumentParser(prog="hstack-scan")
    parser.add_argument("--root", default=".")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    scanners: list[tuple[str, list[str]]] = []
    if shutil.which("gitleaks"):
        scanners.append(("gitleaks", ["gitleaks", "detect", "--no-banner", "--redact", "--source", args.root]))
    if shutil.which("osv-scanner"):
        scanners.append(("osv-scanner", ["osv-scanner", "--recursive", args.root]))
    if not scanners:
        print("hstack-scan: no scanner on PATH. Install gitleaks or osv-scanner yourself. Nothing was downloaded.")
        return 0
    status = 0
    for name, command in scanners:
        shown = " ".join(command)
        if args.dry_run:
            print(f"hstack-scan: would run {shown}")
            continue
        print(f"hstack-scan: running {name}")
        completed = subprocess.run(command)
        if completed.returncode != 0:
            status = completed.returncode
    return status


if __name__ == "__main__":
    sys.exit(main())
